public static boolean esPalindromo(String cadena) {
    cadena = cadena.toLowerCase().replace(" ", "");
    int fin = cadena.length() - 1;
    for (int ini = 0; ini < fin; ini++) {
        if (cadena.charAt(ini) != cadena.charAt(fin)) {
            return false;
        }
        fin--;
    }
    return true;
}
