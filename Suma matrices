package suma_matrices;

public class Suma_matrices {

    public static void main(String[] args) {
        int[][] matrizA = {{1, 2}, {3, 4}};
        int[][] matrizB = {{5, 6}, {7, 8}};
        int[][] resultado = new int[2][2];

        for (int i = 0; i < 2; i++) {
            for (int j = 0; j < 2; j++) {
                resultado[i][j] = matrizA[i][j] + matrizB[i][j];
                System.out.print(resultado[i][j] + " ");
            }
            System.out.println();
        }
    }
    
}
